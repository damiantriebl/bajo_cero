# Local: rama "desarrollo" de Neon.
# Conexión con pooler (la usa la app en runtime)
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Conexión directa sin pooler (la usa Prisma para migraciones)
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Producción: rama "main" de Neon. Solo de referencia para cargar en Vercel
# (allá van como DATABASE_URL y DIRECT_URL). La app no las lee.
PROD_DATABASE_URL=""
PROD_DIRECT_URL=""
